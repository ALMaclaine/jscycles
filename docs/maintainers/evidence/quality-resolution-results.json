  "fixed_defects": [
    {
      "defect": "Alias completion replaces an arbitrary dotted suffix, selecting model.ts instead of model.v2.ts.",
      "impact": "Real cycles are hidden or unrelated file cycles invented.",
      "repair": "Append inferred source extensions to the complete stem; preserve recognized source-suffix substitution and exact-file precedence."
    },
    {
      "defect": "Relative JavaScript suffixes do not select their TypeScript sources.",
      "impact": "Common .js/.jsx source references hide real TypeScript cycles.",
      "repair": "Aliases and relative imports use the same file-candidate routine."
    },
    {
      "defect": "Relative runtime suffixes append a second extension, selecting unrelated model.js.ts.",
      "impact": "A nonexistent runtime module can create a false cycle.",
      "repair": "Substitute recognized suffixes instead of appending a second source extension."
    },
    {
      "defect": "Modern ESM/CommonJS runtime suffixes use an unrelated TypeScript family or fail to reach the matching source.",
      "impact": "Cycles involving explicitly selected .mts/.cts sources are hidden; unrelated .ts sources can invent cycles.",
      "repair": "Explicit .mjs/.mts and .cjs/.cts lookups stay in their respective families; configured source selection is preserved."
    }
  ],
